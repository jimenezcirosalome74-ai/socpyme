# ─── SOC-PYME · variables de entorno (copiá a .env y completá) ───────────────
# Flask
FLASK_CONFIG=production
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos (por defecto SQLite local; para Postgres usá una URL así:)
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/socpyme
# DATABASE_URL=sqlite:///socpyme.db

# Cookies seguras (1 = solo HTTPS). Activar en producción.
SESSION_COOKIE_SECURE=1

# Rate limiting de login/registro (anti fuerza bruta)
RATELIMIT_ENABLED=1
AUTH_RATELIMIT=20 per minute

# Envío de emails de alerta por SMTP (opcional; sin esto, modo demo)
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=secreto
# SMTP_USE_TLS=1
# MAIL_FROM=alertas@tu-dominio.com

# Servidor waitress
HOST=0.0.0.0
PORT=8000
